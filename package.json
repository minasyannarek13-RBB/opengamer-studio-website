{
  "name": "opengamer-studio-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm test:production-config && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:production-config",
    "test:production-config": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/production-config-tests.mjs && node scripts/asset-delivery-tests.mjs && node scripts/social-preview-tests.mjs && node scripts/locale-accessibility-tests.mjs && node scripts/security-header-tests.mjs",
    "qa:visual": "node scripts/visual-qa.mjs"
  },
  "dependencies": {
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.4.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
